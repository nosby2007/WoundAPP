{
  "hosting": {
    "public": "www",
    "site": "innovacare-mobile",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "predeploy": [
      "node scripts/verify-release-source.js"
    ]
  }
}
