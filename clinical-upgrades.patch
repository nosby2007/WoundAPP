+        padding-left: 16px;
+      }
+      li {
+        margin: 2px 0;
+      }
+    `,
+  ],
+})
+export class BedsideSafetyBannerComponent {
+  @Input() snapshot: ClinicalSafetySnapshot | null = null;
+  showDetails = false;
+
+  constructor() {
+    addIcons({
+      warningOutline,
+      alertCircleOutline,
+      shieldCheckmarkOutline,
+      checkmarkCircleOutline,
+      informationCircleOutline,
+      chevronDownOutline,
+      chevronUpOutline,
+    });
+  }
+
+  toggleDetails() {
+    this.showDetails = !this.showDetails;
+  }
+}
